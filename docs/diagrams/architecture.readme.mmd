%% README 专用版本：横向（LR）分层流。
%% 与 architecture.mmd 同一套模块，但只画**层与层之间**的主干依赖、标签压到最短 ——
%% 模块级的完整依赖关系看 assets/module-deps.svg 与 docs/api-list.md。
%% 竖版适合文档站全屏查看，本版适合 README 正文宽度（~820px）内阅读。
flowchart LR
  CLIENT["Claude Code / MCP 客户端<br/>resume_preview · resume_export"]
  BROWSER["浏览器标签页<br/>A4 实时预览"]

  subgraph L0["L0 接入层"]
    direction TB
    IDX["index.ts<br/>MCP 入口"]
    SERVE["serve.ts<br/>独立模式"]
    LS["live-server.ts<br/>HTTP + WS + 监听"]
  end

  subgraph L1["L1 应用层"]
    direction TB
    HANDLERS["handlers.ts<br/>工具实现"]
    ROUTES["routes.ts<br/>路由分发"]
    RSVC["resume-service.ts<br/>列表删除"]
    PREND["page-renderer.ts<br/>模板拼装"]
  end

  subgraph L2["L2 能力层"]
    direction TB
    FUTILS["file-utils.ts<br/>路径校验"]
    RREND["resume-renderer.ts<br/>渲染 PDF / HTML"]
    I18N["i18n.ts<br/>语言取词"]
    HTMLU["html-utils.ts<br/>转义"]
    LOGR["logger.ts<br/>分级日志"]
    CONF["constants.ts<br/>types.ts"]
  end

  subgraph L3["L3 外部依赖与资源"]
    direction TB
    MCPSDK["MCP SDK<br/>stdio 传输"]
    PUPPET["puppeteer<br/>无头 Chromium"]
    WSLIB["ws<br/>WebSocket"]
    PREVIEW["src/preview/*<br/>模板与字典"]
    RSTORE[("resumes/")]
    LOGS[("logs/")]
  end

  CLIENT --> L0
  L0 --> L1
  L1 --> L2
  L2 --> L3
  L0 -. "reload" .-> BROWSER

  classDef actor fill:#eef4ff,stroke:#3b6fd4,color:#12264f
  classDef l0 fill:#e6f7f0,stroke:#1f9d63,color:#0b3d28
  classDef l1 fill:#fff4e0,stroke:#d98b1a,color:#4a2d05
  classDef l2 fill:#f3ecff,stroke:#7a4fd1,color:#2b1650
  classDef l3 fill:#ffecec,stroke:#c0392b,color:#4a1210

  class CLIENT,BROWSER actor
  class IDX,SERVE,LS l0
  class HANDLERS,ROUTES,RSVC,PREND l1
  class FUTILS,RREND,I18N,HTMLU,LOGR,CONF l2
  class MCPSDK,PUPPET,WSLIB,PREVIEW,RSTORE,LOGS l3
